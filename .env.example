# Local mode uses your authenticated Sprite CLI.
# If `sprite list` works in your terminal, the dashboard can read the same account.

# Hosted mode uses this server-only token instead of the local CLI.
# Do not prefix this with NEXT_PUBLIC_.
# SPRITES_API_TOKEN=

# Optional, useful for local mocks or future API environments.
# SPRITES_API_BASE_URL=https://api.sprites.dev
