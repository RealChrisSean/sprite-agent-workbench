# Local mode uses your authenticated Sprite CLI.
# If `sprite list` works in your terminal, the dashboard can read the same account.

# Recommended hosted mode: use a Sprites Custom API Connector.
# The connector stores the credential in Sprites, then this app calls the gateway.
# Do not prefix this with NEXT_PUBLIC_.
# SPRITES_API_GATEWAY_BASE_URL=https://api.sprites.dev/v1/gateway/custom_api/CONNECTION_ID

# Simpler hosted mode: use a server-only token instead of the connector.
# This works, but the Sprite process holds a long-lived token.
# Do not prefix this with NEXT_PUBLIC_.
# SPRITES_API_TOKEN=

# Advanced fallback: app-managed server-side token storage path.
# Prefer the connector above. This file can be captured by filesystem snapshots.
# SPRITE_AGENT_WORKBENCH_SECRET_PATH=/home/sprite/.sprite-agent-workbench/secrets.json

# Optional, useful for local mocks or future API environments.
# SPRITES_API_BASE_URL=https://api.sprites.dev
