# Local mode uses your authenticated Sprite CLI.
# If `sprite list` works in your terminal, the dashboard can read the same account.

# Recommended hosted mode: use a Sprites Custom API Connector.
# The connector stores the credential in Sprites, then this app calls the gateway.
# Do not prefix this with NEXT_PUBLIC_.
# SPRITES_API_GATEWAY_BASE_URL=https://api.sprites.dev/v1/gateway/custom_api/CONNECTION_ID

# Simpler hosted mode: use a server-only token instead of the connector.
# This works, but the Sprite process holds a long-lived token.
# Do not prefix this with NEXT_PUBLIC_.
# SPRITES_API_TOKEN=

# Advanced fallback: app-managed server-side token storage path.
# Prefer the connector above. This file can be captured by filesystem snapshots.
# SPRITE_AGENT_WORKBENCH_SECRET_PATH=/home/sprite/.sprite-agent-workbench/secrets.json

# Optional, useful for local mocks or future API environments.
# SPRITES_API_BASE_URL=https://api.sprites.dev

# --- Workbench write boundaries ---
# Browser writes require an eight-hour HttpOnly admin session unlocked with
# this secret. Machine collectors use a different secret in
# X-Workbench-Ingest-Token. Keep both server-only and use random values.
# WORKBENCH_ADMIN_TOKEN=
# WORKBENCH_INGEST_TOKEN=

# When a protected Workbench URL needs a separate edge bearer credential,
# clients can set this in their own environment. It is not consumed by the app.
# WORKBENCH_EDGE_TOKEN=

# Optional local-only JSONL paths (defaults live under .workbench-state/).
# SPRITE_AGENT_WORKBENCH_OBSERVATIONS_PATH=
# SPRITE_AGENT_WORKBENCH_HEALTH_PROBES_PATH=
# SPRITE_AGENT_WORKBENCH_RUN_EVENTS_PATH=
# SPRITE_AGENT_WORKBENCH_METER_SAMPLES_PATH=

# --- Counter-based usage estimate ---
# Rates checked against the public pricing page. The estimator also applies the
# published 6.25% CPU and 0.25 GB memory floors. Re-check live pricing before
# relying on an estimate; this is not invoice data.
# WORKBENCH_RATE_CPU_PER_HOUR=0.07
# WORKBENCH_RATE_MEMORY_GB_PER_HOUR=0.04375
# WORKBENCH_RATE_HOT_STORAGE_GB_PER_HOUR=0.000683
# WORKBENCH_RATE_COLD_STORAGE_GB_PER_HOUR=0.000027
